{
  "extends": ["next/core-web-vitals", "next/typescript", "prettier"],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    ".next/",
    ".netlify/",
    "out/",
    "build/",
    "next-env.d.ts",
    "tmp/",
    "archive/",
    "docs/old/",
    "docs/**/*.js",
    "docs/**/*.html",
    "supabase/functions/"
  ]
}
